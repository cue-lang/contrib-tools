# Test that `cueckoo version update` detects and installs a newer version.
# Since the pre-run hook fires first, it detects the update, installs the new
# binary, and re-execs. The re-exec'd process is the newly installed binary.

env _CUECKOO_VERSION_OVERRIDE=v0.0.1
exec cueckoo version update
stderr 'cueckoo: updating v0.0.1 -> v0.99.0'

# After auto-update and re-exec, the new binary is running.
stdout 'cueckoo v0.99.0 \[version update\]'
